[
  {
    "id": "bikes-tab",
    "type": "tab",
    "label": "Bike Sharing Operator Dashboard",
    "disabled": false,
    "info": "Historical dashboard; data is served by the verified HTTPS processor API."
  },
  {
    "id": "bikes-ui-in",
    "type": "http in",
    "z": "bikes-tab",
    "name": "Operator dashboard",
    "url": "/bike-sharing",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 180,
    "y": 120,
    "wires": [
      [
        "bikes-ui-template"
      ]
    ]
  },
  {
    "id": "bikes-ui-template",
    "type": "template",
    "z": "bikes-tab",
    "name": "Historical dashboard page",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Bike-sharing operations</title>\n<style>\n:root{font-family:system-ui,sans-serif;color:#14212b;background:#f4f7f8}body{max-width:1180px;margin:2rem auto;padding:0 1rem}header,section{background:#fff;border-radius:10px;padding:1rem 1.25rem;margin:1rem 0;box-shadow:0 1px 5px #13212b18}h1,h2{margin:.3rem 0 1rem}form{display:flex;flex-wrap:wrap;gap:.8rem;align-items:end}label{display:grid;gap:.25rem;font-weight:600}input,select,button{font:inherit;padding:.45rem;border:1px solid #8797a0;border-radius:5px}button{background:#075e74;color:#fff;border:0;cursor:pointer}button:focus,input:focus,select:focus{outline:3px solid #8cc9da}#status{min-height:1.5rem;color:#374d58}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.75rem}.card{background:#edf5f7;padding:.8rem;border-radius:7px}.card strong{display:block;font-size:1.35rem;margin-top:.3rem}table{width:100%;border-collapse:collapse;font-size:.92rem}th,td{text-align:left;padding:.45rem;border-bottom:1px solid #dce4e7}th{background:#f1f5f6;position:sticky;top:0}.scroll{overflow:auto;max-height:28rem}.bar{height:.7rem;background:#087f9d;min-width:2px}.muted{color:#526670;font-size:.9rem}.error{color:#a32222}\n</style>\n</head>\n<body>\n<header><h1>Bike-sharing operations</h1><p class=\"muted\">Historical trips use trip start time in the source UTC-04:00 timezone. Energy coverage and station status observation counts are shown explicitly.</p>\n<form id=\"filters\"><label>From (local)<input id=\"start\" type=\"datetime-local\" value=\"2024-03-13T00:00\" required></label><label>Until (exclusive)<input id=\"end\" type=\"datetime-local\" value=\"2024-03-23T00:00\" required></label><label>Trend interval<select id=\"bucket\"><option value=\"hour\">Hourly</option><option value=\"day\" selected>Daily</option><option value=\"week\">Weekly</option></select></label><button type=\"submit\">Update dashboard</button></form><p id=\"status\" role=\"status\" aria-live=\"polite\"></p></header>\n<section><h2>Selected period</h2><div id=\"summary\" class=\"cards\"></div></section>\n<section><h2>Trip, duration, energy and fare trends</h2><div class=\"scroll\"><table><thead><tr><th>Local bucket</th><th>Trips</th><th>Members</th><th>Casual</th><th>Avg duration (min)</th><th>Known energy (kWh)</th><th>Unknown energy trips</th><th>Estimated fare ($)</th></tr></thead><tbody id=\"trends\"></tbody></table></div></section>\n<section><h2>Trips by time of day</h2><div id=\"periods\" class=\"cards\"></div></section>\n<section><h2>Station utilization</h2><p class=\"muted\">Empty/full shares are fractions of observed status messages, not estimated elapsed time. Gaps are not interpreted as empty or full.</p><div class=\"scroll\"><table><thead><tr><th>Station</th><th>Member departures</th><th>Casual departures</th><th>Member arrivals</th><th>Casual arrivals</th><th>Status updates</th><th>Empty updates</th><th>Full updates</th></tr></thead><tbody id=\"stations\"></tbody></table></div></section>\n<script>\nconst byId=id=>document.getElementById(id);const text=(value)=>value===null||value===undefined?'Unknown':String(value);function cell(value){const td=document.createElement('td');td.textContent=text(value);return td}function row(values){const tr=document.createElement('tr');values.forEach(value=>tr.appendChild(cell(value)));return tr}function card(label,value){const div=document.createElement('div');div.className='card';const title=document.createElement('span');title.textContent=label;const strong=document.createElement('strong');strong.textContent=text(value);div.append(title,strong);return div}\nasync function refresh(event){if(event)event.preventDefault();const status=byId('status');status.className='';status.textContent='Loading…';const start=byId('start').value,end=byId('end').value;if(!start||!end){status.className='error';status.textContent='Choose both local date/time values.';return}const params=new URLSearchParams({start:start+':00-04:00',end:end+':00-04:00',bucket:byId('bucket').value});try{const response=await fetch('/api/analytics?'+params.toString(),{credentials:'same-origin',headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok)throw new Error(data.error||('Request failed ('+response.status+')'));const s=data.summary;byId('summary').replaceChildren(card('Completed trips',s.completed_trips),card('Total duration (hours)',(s.duration_seconds_total/3600).toFixed(2)),card('Average duration (minutes)',s.duration_seconds_average===null?'Unknown':(s.duration_seconds_average/60).toFixed(2)),card('Estimated fare ($)',s.fare_usd_total),card('Known e-bike energy (kWh)',s.energy_kwh_known_total),card('Energy coverage',s.energy_coverage_percent+'%'),card('E-bike trips with unknown energy',s.energy_unknown_trips),card('Warning-bearing trips',s.warning_trips));const trends=byId('trends');trends.replaceChildren(...data.trends.map(t=>row([t.bucket,t.trips,t.member_trips,t.casual_trips,t.duration_seconds_average===null?'Unknown':(t.duration_seconds_average/60).toFixed(2),t.energy_kwh_known,t.energy_unknown_trips,t.fare_usd])));byId('periods').replaceChildren(...data.time_of_day.map(p=>card(p.period,p.trips+' trips')));const stations=byId('stations');stations.replaceChildren(...data.station_utilization.map(s=>row([s.station_name+' ('+s.station_id+')',s.departures_member,s.departures_casual,s.arrivals_member,s.arrivals_casual,s.observed_status_updates,s.empty_updates,s.full_updates])));status.textContent='Updated. Status observations cover '+data.status_coverage.stations_with_observations+' stations; empty/full figures are update shares.';}catch(error){status.className='error';status.textContent='Could not load analytics: '+error.message}}\nbyId('filters').addEventListener('submit',refresh);refresh();\n</script>\n</body>\n</html>",
    "output": "str",
    "x": 440,
    "y": 120,
    "wires": [
      [
        "bikes-ui-response"
      ]
    ]
  },
