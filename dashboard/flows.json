  {
    "id": "dash-assets-allowlist",
    "type": "function",
    "z": "bikes-tab",
    "name": "Resolve fixed asset allowlist",
    "func": "const assets = {\n    \"app.css\": [\"/opt/dashboard/public/app.css\", \"text/css; charset=utf-8\"],\n    \"app.js\": [\"/opt/dashboard/public/app.js\", \"text/javascript; charset=utf-8\"],\n    \"core.js\": [\"/opt/dashboard/public/core.js\", \"text/javascript; charset=utf-8\"],\n    \"leaflet.css\": [\"/opt/dashboard/public/vendor/leaflet/leaflet.css\", \"text/css; charset=utf-8\"],\n    \"leaflet.js\": [\"/opt/dashboard/public/vendor/leaflet/leaflet.js\", \"text/javascript; charset=utf-8\"]\n};\nconst asset = msg.req && msg.req.params && msg.req.params.asset;\nif (!Object.prototype.hasOwnProperty.call(assets, asset)) {\n    msg.statusCode = 404;\n    msg.headers = {\"content-type\":\"application/json; charset=utf-8\", \"cache-control\":\"no-store\"};\n    msg.payload = {error:\"asset not found\"};\n    return [null, msg];\n}\nmsg.filename = assets[asset][0];\nmsg.headers = {\"content-type\":assets[asset][1], \"cache-control\":\"no-cache\"};\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 240,
    "wires": [["dash-assets-file"], ["dash-assets-response"]]
  },
