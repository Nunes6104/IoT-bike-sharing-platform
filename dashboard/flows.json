  {
    "id": "bikes-api-request",
    "type": "function",
    "z": "bikes-tab",
    "name": "Add service token and fixed API target",
    "func": "const token = global.get('analyticsToken');\nif (!token) {\n    msg.statusCode = 503;\n    msg.payload = {error: 'Analytics service credentials are unavailable'};\n    return [null, msg];\n}\nconst query = msg.req && msg.req.url && msg.req.url.includes('?') ? msg.req.url.slice(msg.req.url.indexOf('?')) : '';\nmsg.url = 'https://processor:8443/api/analytics' + query;\nmsg.method = 'GET';\nmsg.headers = {authorization: 'Bearer ' + token, accept: 'application/json'};\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 240,
    "wires": [
      [
        "bikes-api-http"
      ],
      [
        "bikes-api-response"
      ]
    ]
  },
