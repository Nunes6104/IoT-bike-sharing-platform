  {
    "id": "bikes-api-proxy",
    "type": "function",
    "z": "bikes-tab",
    "name": "Fixed HTTPS target and server-side token",
    "func": "const token = global.get('analyticsToken');\nif (!token) {\n    msg.statusCode = 503;\n    msg.payload = {error: 'Analytics service credentials are unavailable'};\n    return [null, msg, null];\n}\nconst route = msg.req && msg.req.path;\nconst routes = ['/api/analytics', '/api/stations/latest', '/api/ml/model', '/api/ml/profiles', '/api/ml/flags'];\nif (!routes.includes(route)) {\n    msg.statusCode = 404;\n    msg.payload = {error: 'not found'};\n    return [null, null, msg];\n}\nconst query = msg.req.url.includes('?')\n    ? msg.req.url.slice(msg.req.url.indexOf('?')) : '';\nmsg.url = 'https://processor:8443' + route + query;\nmsg.method = 'GET';\nmsg.headers = {authorization: 'Bearer ' + token, accept: 'application/json'};\nreturn [msg, null, null];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 380,
    "wires": [["bikes-api-http"], ["bikes-api-response"], ["bikes-api-response"]]
  },
  {
